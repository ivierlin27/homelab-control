# Test C: GLM-4.5-Air-REAP-82B IQ4_XS — experts on GPU (no -ot CPU offload)
# Phase 5 used full GLM-4.5-Air with expert CPU offload; REAP shrinks enough to stay GPU-resident.
LAB_NAME=glm45air-reap82-llamacpp
LAB_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LAB_GPUS=all
LAB_PORT=8002
LAB_API_KEY=lab-reap-glm45air
# First shard path; llama-server loads index from same directory when both shards present.
LAB_MODEL_PATH=/mnt/data/models/gguf/glm45air-reap82-iq4xs/GLM-4.5-Air-REAP-82B-A12B-IQ4_XS-00001-of-00002.gguf
LAB_SERVED_NAME=lab-glm45air-reap82-llamacpp
LAB_ENV_VARS=""

LAB_LLAMACPP_ARGS="\
  -ngl 999 \
  -ts 1,1 \
  -fa on \
  --jinja \
  -c 32768 \
  --parallel 1 \
  --threads 12 \
  --metrics"
