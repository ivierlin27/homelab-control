# Test D: strong REAP on GPU1 only (llama.cpp single-GPU; fast uses GPU0)
LAB_NAME=dual-strong-glm47-reap-gpu1
LAB_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LAB_GPUS=1
LAB_PORT=8002
LAB_API_KEY=lab-reap-glm47-dual
LAB_MODEL_PATH=/mnt/data/models/gguf/glm47-flash-reap23-ud-q4kxl/GLM-4.7-Flash-REAP-23B-A3B-UD-Q4_K_XL.gguf
LAB_SERVED_NAME=lab-reap-strong-glm47-dual
LAB_ENV_VARS="CUDA_VISIBLE_DEVICES=1"

# No -ts split: entire model on GPU1 (~14GB Q4 + KV at 98K)
LAB_LLAMACPP_ARGS="\
  -ngl 999 \
  -fa on \
  --jinja \
  -c 98304 \
  --parallel 2 \
  --threads-http 4 \
  --metrics \
  --temp 1.0 \
  --top-p 0.95 \
  --min-p 0.01"
