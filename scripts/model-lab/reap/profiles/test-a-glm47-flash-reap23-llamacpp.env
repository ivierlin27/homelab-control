# Test A: GLM-4.7-Flash-REAP-23B via llama.cpp (Unsloth UD-Q4_K_XL)
LAB_NAME=glm47-flash-reap23-llamacpp
LAB_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LAB_GPUS=all
LAB_PORT=8002
LAB_API_KEY=lab-reap-glm47
LAB_MODEL_PATH=/mnt/data/models/gguf/glm47-flash-reap23-ud-q4kxl/GLM-4.7-Flash-REAP-23B-A3B-UD-Q4_K_XL.gguf
LAB_SERVED_NAME=lab-glm47-flash-reap23-llamacpp
LAB_ENV_VARS=""

# Z.ai / Unsloth: temp 1.0 top-p 0.95 for chat; tool-calling uses 0.7/1.0 in bench.
# Start at 64K; expand to 131K/200K after smoke. --repeat-penalty 1.0 per Unsloth Jan 2026 fix.
LAB_LLAMACPP_ARGS="\
  -ngl 999 \
  -ts 1,1 \
  -fa on \
  --jinja \
  -c 65536 \
  --parallel 4 \
  --threads-http 8 \
  --metrics \
  --temp 1.0 \
  --top-p 0.95 \
  --min-p 0.01"
