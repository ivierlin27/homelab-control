# Test A promote: cerebras/GLM-4.7-Flash-REAP-23B-A3B on vLLM (after llama.cpp wins smoke)
LAB_NAME=glm47-flash-reap23-vllm
LAB_IMAGE=docker.io/vllm/vllm-openai:latest
LAB_GPUS=all
LAB_PORT=8002
LAB_API_KEY=lab-reap-glm47
LAB_MODEL=cerebras/GLM-4.7-Flash-REAP-23B-A3B
LAB_SERVED_NAME=lab-glm47-flash-reap23-vllm
LAB_ENV_VARS="VLLM_ATTENTION_BACKEND=FLASHINFER PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"

LAB_VLLM_ARGS="\
  --tensor-parallel-size 2 \
  --dtype bfloat16 \
  --kv-cache-dtype fp8 \
  --max-model-len 131072 \
  --max-num-batched-tokens 8192 \
  --max-num-seqs 16 \
  --gpu-memory-utilization 0.88 \
  --enable-prefix-caching \
  --enable-chunked-prefill \
  --enable-auto-tool-choice \
  --tool-call-parser glm47 \
  --reasoning-parser glm45 \
  --trust-remote-code \
  --disable-custom-all-reduce"
