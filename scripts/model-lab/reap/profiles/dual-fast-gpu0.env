# Test D: fast lane on GPU0 only (runs alongside strong on GPU1)
LAB_NAME=dual-fast-gpu0
LAB_IMAGE=docker.io/vllm/vllm-openai:latest
LAB_GPUS=0
LAB_PORT=8000
LAB_API_KEY=lab-reap-fast
LAB_MODEL=Qwen/Qwen2.5-7B-Instruct
LAB_SERVED_NAME=lab-reap-fast-7b
LAB_ENV_VARS=""

LAB_VLLM_ARGS="\
  --dtype auto \
  --max-model-len 16384 \
  --gpu-memory-utilization 0.82 \
  --kv-cache-dtype fp8 \
  --max-num-batched-tokens 4096 \
  --max-num-seqs 8 \
  --enable-prefix-caching \
  --enable-chunked-prefill \
  --enable-auto-tool-choice \
  --tool-call-parser hermes"
