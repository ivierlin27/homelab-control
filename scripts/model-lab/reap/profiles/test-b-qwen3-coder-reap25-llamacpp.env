# Test B fallback: REAP-25B via GGUF when AWQ quant is not ready
LAB_NAME=qwen3-coder-reap25-llamacpp
LAB_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LAB_GPUS=all
LAB_PORT=8002
LAB_API_KEY=lab-reap-qwen3-coder25
LAB_MODEL_PATH=/mnt/data/models/gguf/qwen3-coder-reap25-q4km/Qwen3-Coder-REAP-25B-A3B-Q4_K_M.gguf
LAB_SERVED_NAME=lab-qwen3-coder-reap25-llamacpp
LAB_ENV_VARS=""

LAB_LLAMACPP_ARGS="\
  -ngl 999 \
  -ts 1,1 \
  -fa on \
  --jinja \
  -c 131072 \
  --parallel 4 \
  --threads-http 8 \
  --metrics"
