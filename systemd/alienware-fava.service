[Unit]
Description=Homelab finance · Fava (read-only Beancount UI)
After=network-online.target
Wants=network-online.target
Documentation=file:%h/git/homelab-control/docs/runbooks/fava.md

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-%h/.config/homelab-control/fava.env
Environment=FAVA_LEDGER_DIR=%h/finance/ledger
Environment=FAVA_HOST=127.0.0.1
Environment=FAVA_PORT=5002
Environment=BEANCOUNT_FILE=/bean/main.beancount
ExecStartPre=/usr/bin/test -f ${FAVA_LEDGER_DIR}/main.beancount
ExecStart=/usr/bin/podman run -d --name homelab-fava --replace \
  -p ${FAVA_HOST}:${FAVA_PORT}:5000 \
  -v ${FAVA_LEDGER_DIR}:/bean:ro,Z \
  -e BEANCOUNT_FILE=${BEANCOUNT_FILE} \
  yegle/fava:latest
ExecStop=-/usr/bin/podman stop -t 15 homelab-fava
TimeoutStartSec=120

[Install]
WantedBy=default.target
