# Copy to ~/.config/homelab-control/agent-finance.env on Alienware.
# Merge secrets from Infisical / existing agent-finance.env — do not commit live values.

AGENT_PRINCIPAL=agent:finance

# Required for: python3 -m apps.finance_agent categorize --llm
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:4000/v1
MODEL_GATEWAY_API_KEY=replace-me

# Optional: auto-post Planka cards when categorize defers rows
PLANKA_BASE_URL=https://planka.dev-path.org
PLANKA_API_KEY=replace-me
# Finance board id (from Planka URL: /boards/<id>) — used by finance smoke cleanup
PLANKA_FINANCE_BOARD_ID=replace-me
# List on the finance Planka board (e.g. "Categorize review")
PLANKA_FINANCE_DEFER_LIST_ID=replace-me

# Infisical token for finance/* secrets (issued per identity runbook)
INFISICAL_TOKEN=replace-me
