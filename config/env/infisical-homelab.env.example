# Copy to ~/.config/homelab-control/infisical-homelab.env on Alienware (mode 0600).
# Machine identity / service token for the Infisical **homelab** project (not finance).
#
# Create in Infisical UI:
#   Project "homelab" → Access → Machine Identities (or Service Tokens)
#   Scope: read secrets under /homelab/npm
#
# Project ID: homelab → Project Settings → copy UUID into npm.config or here.

INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
