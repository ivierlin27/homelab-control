# Copy to ~/.config/homelab-control/fava.env on Alienware.
# Read-only Fava UI over ~/finance/ledger (see systemd/alienware-fava.service).

# Host path to the git checkout (must contain main.beancount)
FAVA_LEDGER_DIR=%h/finance/ledger

# Inside the container (do not change unless the mount changes)
BEANCOUNT_FILE=/bean/main.beancount

# Published on loopback for reverse-proxy upstream (Caddy/Traefik on LAN)
# LAN bind so NPM (192.168.1.42) can reach Alienware; protect with Authentik on NPM.
FAVA_HOST=0.0.0.0
FAVA_PORT=5002

# Public URL (for docs / dashboard links only)
FAVA_PUBLIC_URL=https://fava.dev-path.org

# Pinned in systemd/alienware-fava.service (2026-05-30, yegle/fava:latest)
# FAVA_IMAGE=docker.io/yegle/fava@sha256:d94c2011d7ed9f0adf2576c640b8f0164586fe23f32d982b5b80259f102e025e
