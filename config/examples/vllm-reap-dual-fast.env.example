# Example: fast lane for REAP dual mode (GPU0, port 8000).
# Copy to ~/.config/homelab-control/ only after Test D harness passes.
# Do NOT enable alongside alienware-vllm-strong-long (needs both GPUs today).

VLLM_FAST_IMAGE=docker.io/vllm/vllm-openai:latest
VLLM_FAST_GPU_DEVICE=0
VLLM_FAST_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_FAST_SERVED_MODEL_NAME=homelab-fast
VLLM_FAST_API_KEY=REPLACE_ME
VLLM_FAST_DTYPE=auto
VLLM_FAST_MAX_MODEL_LEN=16384
VLLM_FAST_GPU_MEMORY_UTILIZATION=0.82
VLLM_FAST_KV_CACHE_DTYPE=fp8
VLLM_FAST_MAX_NUM_BATCHED_TOKENS=4096
VLLM_FAST_MAX_NUM_SEQS=8
VLLM_FAST_TOOL_PARSER=hermes
VLLM_FAST_EXTRA_ARGS=
